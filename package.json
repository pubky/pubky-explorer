{
  "name": "pubky-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "VITE_TESTNET=false npm run build -- --base / --outDir dist && VITE_TESTNET=true npm run build -- --base /testnet/ --outDir dist/testnet",
    "preview": "vite preview",
    "preview:site": "vite preview --mode site --outDir dist"
  },
  "dependencies": {
    "@synonymdev/pubky": "^0.6.0",
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "vite": "^7.2.4",
    "vite-plugin-solid": "^2.11.8"
  }
}
